# Production builds must use HTTPS Supabase project values.
# Copy to your local shell/CI secrets, not to a committed .env.production file.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-production-anon-key
REACT_APP_ALLOW_LOCAL_DEMO=false
REACT_APP_VERSION=1.0.0
# Host that serves /.well-known/assetlinks.json and the /reset App Link.
REACT_APP_AUTH_LINK_HOST=petpal.example.com
# The pilot is Foster only. Set to true to show Match (playdates and walks).
REACT_APP_ENABLE_MATCH=false
